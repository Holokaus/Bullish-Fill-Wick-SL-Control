//@version=5
strategy("Bullish Fill Wick - E4 F_act_loserMFEp50", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=2.0, currency=currency.USDT, commission_type=strategy.commission.percent, commission_value=0.0075)

// ─── INPUTS ───
wick_threshold_bps   = input.int(90, "Wick Threshold (bps)", minval=1)           // W3 = 90 bps
tp_mult              = input.float(1.5, "TP Multiplier (× wick_gap)", step=0.1)   // 1.5×
activation_mult      = input.float(0.971, "Activation Multiplier (× wick_gap)", step=0.001) // 0.971× (P50 loser MFE)
breakeven_buffer_bps = input.float(15.0, "Breakeven Buffer (bps)", step=0.1)     // +15 bps
time_stop_bars       = input.int(24, "Time Stop (bars)", minval=1)                // 24 bars = 4 days on 4h
use_heikin_ashi      = input.bool(false, "Use Heikin Ashi for Signal")

// ─── HELPERS ───
src = use_heikin_ashi ? request.heikinashi(syminfo.tickerid) : close
o   = use_heikin_ashi ? open  : open
h   = use_heikin_ashi ? high  : high
l   = use_heikin_ashi ? low   : low
c   = use_heikin_ashi ? close : close

// Upper wick in price and bps
upper_wick_price = h - math.max(o, c)
wick_bps         = (upper_wick_price / c) * 10000

// Signal: upper wick ≥ threshold, no dip filter (NODIP)
signal = wick_bps >= wick_threshold_bps

// ─── STATE VARIABLES ───
var float entry_price      = na
var float tp_price         = na
var float activation_price = na
var float stop_price       = na
var int   entry_bar        = na
var bool  activated        = false
var float signal_wick_gap  = na

// ─── ENTRY LOGIC ───
if strategy.position_size == 0 and signal
    // Calculate levels at signal bar
    signal_wick_gap  := upper_wick_price
    float body_top   = math.max(o, c)
    tp_price         := body_top + tp_mult * signal_wick_gap
    activation_price := c + activation_mult * signal_wick_gap  // from next bar open ≈ close
    stop_price       := na  // no initial hard stop
    entry_bar        := bar_index
    activated        := false
    
    strategy.entry("Long", strategy.long, comment="E4 W3_NODIP")

// ─── MANAGE OPEN POSITION ───
if strategy.position_size > 0
    // Time stop check
    bars_held = bar_index - entry_bar
    if bars_held >= time_stop_bars
        strategy.close("Long", comment="Time Stop")
        // Reset state
        entry_price := na
        tp_price := na
        activation_price := na
        stop_price := na
        activated := false
    
    // Activation check: price reaches activation level
    if not activated and high >= activation_price
        activated := true
        stop_price := strategy.position_avg_price * (1 + breakeven_buffer_bps / 10000)
        // Plot activation for debugging
        // label.new(bar_index, high, "ACTIVATED", color=color.green)
    
    // Stop loss check (after activation)
    if activated and low <= stop_price
        strategy.close("Long", comment="Breakeven Stop")
        entry_price := na
        tp_price := na
        activation_price := na
        stop_price := na
        activated := false
    
    // Take profit check
    if high >= tp_price
        strategy.close("Long", comment="TP Hit")
        entry_price := na
        tp_price := na
        activation_price := na
        stop_price := na
        activated := false

// ─── PLOTTING ───
plot(signal ? high + upper_wick_price * 0.1 : na, "Signal", color=color.lime, style=plot.style_circles, linewidth=3)
plot(strategy.position_size > 0 ? tp_price : na, "Take Profit", color=color.green, style=plot.style_linebr)
plot(strategy.position_size > 0 and activated ? stop_price : na, "Breakeven Stop", color=color.orange, style=plot.style_linebr)
plot(strategy.position_size > 0 ? activation_price : na, "Activation Level", color=color.blue, style=plot.style_circles)

// ─── DEBUG LABELS ───
var label signal_label = na
if signal and strategy.position_size == 0
    label.delete(signal_label)
    signal_label := label.new(bar_index, high, "W3 SIGNAL\nWick: " + str.tostring(wick_bps, "#.0") + " bps", color=color.lime, textcolor=color.black, style=label.style_label_up)

// ─── ALERTS ───
alertcondition(signal and strategy.position_size == 0, title="E4 W3 Signal", message="E4 F_act_loserMFEp50: Bullish Fill Wick signal detected (wick ≥ " + str.tostring(wick_threshold_bps) + " bps)")
alertcondition(strategy.position_size > 0 and not activated and high >= activation_price, title="Activation Triggered", message="E4: Breakeven activation triggered at " + str.tostring(activation_price, "#.####"))
alertcondition(strategy.position_size > 0 and activated and low <= stop_price, title="Breakeven Stop Hit", message="E4: Breakeven stop hit at " + str.tostring(stop_price, "#.####"))
alertcondition(strategy.position_size > 0 and high >= tp_price, title="Take Profit Hit", message="E4: Take profit hit at " + str.tostring(tp_price, "#.####"))

// ─── STRATEGY SETTINGS ───
// Default: 2% equity per trade, 0.075% commission per side (15 bps round-trip)
// Pyramiding disabled (default), process_orders_on_close=true (default)